# نواة ERP الجامعي — قالب البيئة. انسخه إلى .env وعدّل القيم (cp .env.example .env)
# الأسطر المعلَّقة بـ # هي القيم الافتراضية؛ المتغيرات الفعلية في بيئة التشغيل لها الأولوية.

# ---- التشغيل ----
# PORT=3000
# HOST=127.0.0.1              # 0.0.0.0 للاستضافة أو للتجربة على الهاتف عبر الشبكة المحلية
# SESSION_HOURS=8             # مدة الجلسة بالساعات

# ---- قاعدة البيانات والمجلدات ----
# DB_PATH=./data/uni-erp.db
# UPLOAD_DIR=./data/uploads
# LOG_DIR=./data/logs
# LOG_LEVEL=info              # error | warn | info

# ---- الأمان (اقرأ docs/SECURITY.md قبل النشر) ----
# SCRYPT_N=32768              # تكلفة تجزئة كلمات المرور؛ لا تُخفض في الإنتاج
# SIGNING_KEY=                # مفتاح توقيع الوثائق؛ يُولَّد تلقائياً في data/secret.key إن تُرك فارغاً (احفظه مع النسخ الاحتياطي!)
# COOKIE_SECURE=1             # إلزامي خلف HTTPS: يمنع تسريب الكوكي عبر http
# TRUST_PROXY=1               # اضبطه =1 خلف موازن تحميل أو وسيط (load balancer) ليُعتمد X-Forwarded-For

# ---- الهوية العامة (روابط التحقق ورموز QR داخل الوثائق) ----
# UNIVERSITY_NAME=الجامعة السورية للعلوم الأمنية   # يجب أن يحوي حروفاً عربية
# PUBLIC_URL=                 # العنوان العام https، مثال: https://erp.university.edu

# ---- النسخ الاحتياطي ----
# BACKUP_DIR=./data/backups  # الافتراضي: data/backups
# BACKUP_KEEP=14              # عدد النسخ المحتفظ بها
# BACKUP_HOUR=1               # ساعة الإنشاء التلقائي (UTC)
# BACKUP_AUTO=1               # 0 لإيقاف النسخ التلقائي
# BACKUP_PASSPHRASE=          # يُشفّر النسخ AES-256-GCM؛ ضعه إلزامياً في الإنتاج (النسخ تحوي بيانات الطلاب ومفتاح التوقيع)
# BACKUP_PUT_URL=             # عنوان PUT لرفع نسخة خارجية؛ اضبطه أو انسخ مجلد النسخ دورياً إلى وسيط آخر
# BACKUP_PUT_AUTH=            # ترويسة مصادقة للرفع الخارجي (Bearer ... مثلاً)

# ---- الختم الزمني RFC 3161 (اختياري، يوثّق وقت إصدار الشهادات بطرف ثالث) ----
# TSA_URL=http://timestamp.digicert.com

# ---- إشعارات الجوال Web Push ----
# VAPID_PUBLIC_KEY=           # تُولَّد تلقائياً إن تُركت فارغة
# VAPID_PRIVATE_KEY=
# PUSH_ALLOW_HOSTS=           # قواعد مضيفات خدمات الدفع الإضافية مفصولة بفواصل
