# البيئة والأسرار: لا تُرفع أبداً
.env
.env.*
!.env.example

# بيانات التشغيل: قاعدة البيانات، مفتاح التوقيع، المرفقات، السجلات، النسخ الاحتياطية
data/

# حزمة التسليم المؤقتة عبر الخادم (وليست جزءاً من المشروع)
public/download/

# اعتماديات وأقراع (لا اعتماديات للإنتاج، لكن وجودها خلل بيئي)
node_modules/

# ملفات النظام والمحررات
*.log
.DS_Store
Thumbs.db
